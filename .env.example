# Example settings for running the adapter from a shell. The adapter reads the
# process environment only; it does not load this file. Keep secret files
# outside the repository and chmod them 0600. Set NAME or NAME_FILE, never both.

LISTEN_ADDRESS=127.0.0.1:8787
# DATABASE_PATH defaults to ~/Library/Application Support/orka-gateway-imessage/adapter.db
IMSG_PATH=imsg

# Stable accountId for this Mac's Messages account, used by the GatewayBinding.
IMESSAGE_ACCOUNT_ID=my-mac-messages
# Comma-separated E.164 phone numbers and email addresses. Required.
IMESSAGE_ALLOWED_SENDERS=+14155551212,someone@example.com
IMESSAGE_ALLOW_GROUPS=false

# http is accepted only for loopback, for example a kubectl port-forward.
ORKA_GATEWAY_INGRESS_URL=http://127.0.0.1:8081/api/v1/gateways/<namespace>/imessage/events
ORKA_GATEWAY_INBOUND_TOKEN_FILE=
ORKA_GATEWAY_OUTBOUND_TOKEN_FILE=

REQUEST_TIMEOUT=15s
SEND_TIMEOUT=60s
SHUTDOWN_TIMEOUT=20s
LOG_LEVEL=info
