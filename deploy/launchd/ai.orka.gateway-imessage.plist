<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  User LaunchAgent template. Replace every REPLACE_WITH_* value, copy to
  ~/Library/LaunchAgents/ai.orka.gateway-imessage.plist, and grant Full Disk
  Access to the adapter binary (the responsible process for imsg).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.orka.gateway-imessage</string>
  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_WITH_ADAPTER_BINARY</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>IMESSAGE_ACCOUNT_ID</key>
    <string>REPLACE_WITH_IMESSAGE_ACCOUNT_ID</string>
    <key>IMESSAGE_ALLOWED_SENDERS</key>
    <string>REPLACE_WITH_ALLOWED_SENDERS</string>
    <key>ORKA_GATEWAY_INGRESS_URL</key>
    <string>REPLACE_WITH_ORKA_GATEWAY_INGRESS_URL</string>
    <key>ORKA_GATEWAY_INBOUND_TOKEN_FILE</key>
    <string>REPLACE_WITH_SECRET_DIR/orka-gateway-inbound-token</string>
    <key>ORKA_GATEWAY_OUTBOUND_TOKEN_FILE</key>
    <string>REPLACE_WITH_SECRET_DIR/orka-gateway-outbound-token</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>REPLACE_WITH_LOG_DIR/orka-gateway-imessage.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_WITH_LOG_DIR/orka-gateway-imessage.log</string>
</dict>
</plist>
